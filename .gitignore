# Terraform state and working files
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Provider lock file IS committed on purpose for reproducible provider
# versions across consumers (do not ignore .terraform.lock.hcl).

# Variable files may contain environment-specific values — never commit them.
# Consumers copy terraform.tfvars.example to terraform.tfvars locally.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Lambda build artifacts (generated by archive_file)
builds/
Lambda/*.zip

# Runtime output written by local_file (both the fixed name and the
# region-suffixed variants, e.g. mgn-init-output-us-east-1.json)
mgn-init-output.json
mgn-init-output*.json
